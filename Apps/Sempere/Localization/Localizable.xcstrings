    "iCloud Drive" : {
      "comment" : "Title of the iCloud Drive help; Apple's product name, not translated",
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "iCloud Drive could not download “%@”: %@" : {
      "comment" : "%1$@ is a file name, %2$@ the reason iCloud gave",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no ha podido descargar “%1$@”: %2$@"
          }
        }
      }
    },
    "iCloud Drive did not deliver the vault's files: %lld of %lld are still not downloaded after %@ without progress. Check that this device is online and signed in to iCloud Drive, then try again." : {
      "comment" : "The numbers are files not downloaded and all files; %@ is a number of seconds",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no ha entregado los archivos de la bóveda (sin descargar: %1$lld de %2$lld) tras %3$@ sin avances. Comprueba que este dispositivo tiene conexión y ha iniciado sesión en iCloud Drive, y vuelve a intentarlo."
          }
        }
      }
    },
    "iCloud Drive has not delivered %@ for %@. Check that this device is online and signed in to iCloud Drive. Sempere keeps trying." : {
      "comment" : "First %@ is a number of notes, second a number of seconds",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no ha entregado %@ en %@. Comprueba que este dispositivo tiene conexión y ha iniciado sesión en iCloud Drive. Sempere sigue intentándolo."
          }
        }
      }
    },
    "iCloud Drive has not delivered %lld notes yet. Every note must be on this device before the vault can be re-encrypted. Check that it is online and try again." : {
      "comment" : "Migration error",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "iCloud Drive has not delivered %lld note yet. Every note must be on this device before the vault can be re-encrypted. Check that it is online and try again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "iCloud Drive has not delivered %lld notes yet. Every note must be on this device before the vault can be re-encrypted. Check that it is online and try again."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "iCloud Drive aún no ha entregado %lld de notas. Todas las notas deben estar en este dispositivo antes de volver a cifrar la bóveda. Comprueba que tiene conexión y vuelve a intentarlo."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "iCloud Drive aún no ha entregado %lld nota. Todas las notas deben estar en este dispositivo antes de volver a cifrar la bóveda. Comprueba que tiene conexión y vuelve a intentarlo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "iCloud Drive aún no ha entregado %lld notas. Todas las notas deben estar en este dispositivo antes de volver a cifrar la bóveda. Comprueba que tiene conexión y vuelve a intentarlo."
                }
              }
            }
          }
        }
      }
    },
    "iCloud Drive has not delivered all of this note's files yet. Try again in a moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive aún no ha entregado todos los archivos de esta nota. Vuelve a intentarlo en un momento."
          }
        }
      }
    },
    "iCloud Drive has not listed this note's files yet (%lld missing). Try again in a moment." : {
      "comment" : "The number is files missing. [not-plural]: the Spanish avoids number agreement (sin listar: N)",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive aún no ha listado los archivos de esta nota (sin listar: %lld). Vuelve a intentarlo en un momento."
          }
