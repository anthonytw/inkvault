<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (INFOPLIST_KEY_* build settings). -->
	<!-- Mirrors the maintainer's App Store Connect answer (build 2): standard, mass-market
	     encryption that qualifies for the exemption, so no per-build question
	     (docs/appstore/export-compliance.md). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.anthonytw.sempere.vault</string>
			<key>UTTypeDescription</key>
			<string>Sempere Vault</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.directory</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sempere</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.anthonytw.sempere.notes</string>
			<key>UTTypeDescription</key>
			<string>Sempere Notes (drag inside the app)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.anthonytw.sempere.notebook</string>
			<key>UTTypeDescription</key>
			<string>Sempere Notebook (drag inside the app)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Sempere Vault</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.anthonytw.sempere.vault</string>
			</array>
		</dict>
	</array>
	<!-- sempere://quick-voice/settings and …/recording: the widgets, the Control Center control and the
	     Live Activity open the app there (VoiceNoteLink, docs/quick-capture.md). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.anthonytw.sempere</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sempere</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Recording keeps running with the screen locked or the app in the background (docs/attachments.md §13). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
